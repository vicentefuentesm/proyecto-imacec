# Copiar este archivo a .env y completar con sus credenciales.
# El archivo .env NUNCA se sube a GitHub (esta en .gitignore).

# Banco Central de Chile - registro gratuito en https://si3.bcentral.cl/Siete/es/Siete/API
BCCH_USUARIO=x
BCCH_PASSWORD=x
BCCH_TOKEN=x

# FRED - API key gratuita en https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=su_api_key_de_32_caracteres
